DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# Comma-separated referral codes that give learners at sponsored schools Gold for free (server only).
REFERRAL_CODES=

# Server-only Paystack key. Use sk_test_ locally; sk_live_ for Vercel production.
PAYSTACK_SECRET_KEY=
# Public origin for checkout redirects. Set http://localhost:3000 locally.
PAYMENT_SITE_URL=https://edify-sigma-plum.vercel.app

# Classmate challenges, online status, chat and voice notes (see docs/challenges.md). ALL OFF by default: nothing is
# reachable by a child until these are set to the word true. Apply the matching db/migrations SQL by hand first.
# Master switch (phase 1: links, challenges, leaderboard, parent controls; needs db/migrations/010).
CHALLENGES_ENABLED=
# Phase 2: "Online now" (needs 011). Phase 3: text chat (needs 012). Phase 4: voice notes (needs 013 and the chat switch).
CHALLENGES_PRESENCE=
CHALLENGES_CHAT=
CHALLENGES_VOICE=
# Any random string of 16+ characters. Vercel Cron sends it so only Vercel can run the daily clean-up of expired chats.
# Without it the clean-up never runs (expired data is still hidden from readers, but stays in the database).
CRON_SECRET=
